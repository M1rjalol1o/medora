# Bu faylni ".env" nomi bilan nusxalang va kalitlarni yozing. .env faylini hech kimga bermang.

# Google AI Studio bepul kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Zaxira (ixtiyoriy): OpenRouter bepul modellari — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Tartib: qaysi biri birinchi sinaladi
# OCR_PROVIDERS=gemini,openrouter,tesseract
